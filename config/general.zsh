# Editor
export EDITOR="${commands[nvim]:-${commands[vim]:-vi}}"

# Need to use gpg-agent with pinentry in macOS (faster version https://unix.stackexchange.com/questions/608842/zshrc-export-gpg-tty-tty-says-not-a-tty)
export GPG_TTY=$TTY # $(tty)

# File colors by type and extension (used by eza and completion lists), generated by vivid.
# Cached, as generating takes ~7ms; regenerated when the theme changes or vivid is reinstalled
# (its install dir, not the binary, gets a new mtime)
if (( $+commands[vivid] )); then
  () {
    local theme=ansi # uses the terminal's own palette; see `vivid themes`
    local cache=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/ls_colors-$theme
    if [[ ! -s $cache || ${commands[vivid]:A:h:h} -nt $cache ]]; then
      command mkdir -p ${cache:h} && vivid generate $theme >| $cache
    fi
    export LS_COLORS=$(<$cache)
  }
fi

# History (set before the OMZ history lib)
HISTSIZE=100000
SAVEHIST=100000
setopt hist_ignore_all_dups # remove the older duplicate when a command is re-entered
setopt hist_reduce_blanks   # remove superfluous blanks before recording
